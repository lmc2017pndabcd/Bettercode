# ===== 大模型后端(LLM)=====
# openai = OpenAI 兼容端点(DeepSeek / OpenAI / 中转 / Anthropic 的兼容端点)
# anthropic = Anthropic 原生 SDK(/v1/messages)
LLM_PROVIDER=openai
# 优先于 OPENAI_API_KEY 的通用 key(可选)
LLM_API_KEY=
# 启动时自动使用的模型名,留空则启动时询问
LLM_MODEL=

# --- OpenAI 兼容端点 ---
# 接口地址(建议只写到 /v1;若存了完整 /chat/completions 路径,代码会自动剥离)
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 请替换为你的真实 API Key(密钥勿提交到仓库/镜像)
OPENAI_API_KEY=sk-REPLACE_ME

# --- Anthropic 原生(LLM_PROVIDER=anthropic 时)---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# 走中转/代理时填写,直连留空
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# ===== RAG 知识库(PostgreSQL + pgvector)=====
# 本机默认连接串;容器部署时改为 postgresql://postgres:postgres@postgres:5432/rag_kb
DATABASE_URL=postgresql://localhost:5432/rag_kb
EMBEDDING_PROVIDER=local            # local | api
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_DIM=512
CHUNK_SIZE=400
CHUNK_OVERLAP=50
RAG_CHAT_MODEL=deepseek-chat

# ===== Embedding 模型下载镜像(可选,网络受限时启用)=====
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ===== 沙箱命令执行(可选)=====
RUN_SANDBOX=docker                   # docker | local
RUN_TIMEOUT=120
RUN_TEST_CMD=make test
RUN_DOCKER_IMAGE=python:3.12-slim
RUN_MAX_OUTPUT=8000

# ===== 工具调用轮次上限 =====
MAX_TOOL_ROUNDS=30                   # 普通对话单轮最多连续调用工具次数
MAX_RELEASE_ROUNDS=50                # 上线模式(/release)的轮次上限

# ===== 数据库自动启动 =====
# 连接失败时自动用 brew services 启动的服务名
PG_SERVICE=postgresql@17

# ===== Graph RAG =====
GRAPH_RAG=1                          # 检索时融合知识图谱(0 关闭)
GRAPH_MAX_HOPS=2                     # 图多跳扩展跳数
GRAPH_ENTITY_TOP_K=3                 # 种子实体数
GRAPH_RELATION_LIMIT=20              # 每跳关系上限

# ===== MCP(可选)=====
# 指定 MCP 配置文件路径;默认读取项目根 mcp_servers.json 或 ~/.bettercode/mcp.json
MCP_CONFIG=
# HTTP/SSE 型 MCP 服务器认证(飞书等),mcp_servers.json 里用 ${MCP_BEARER_TOKEN} 引用
MCP_BEARER_TOKEN=
# 飞书本地 lark-mcp 的 userKey(文档访问身份),url 里用 ${MCP_USER_KEY} 引用
MCP_USER_KEY=
