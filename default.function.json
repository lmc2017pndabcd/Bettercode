{
    "funcs":{
        "run_func":{
            "type":"function",
            "function":{
                "name":"run_func",
                "description":"Run function in a script.(This is for skills,Don`t use this tool when testing user`s program)",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "script":{
                            "type":"string",
                            "description":"the script file(use absolute path)"
                        },
                        "function":{
                            "type":"string",
                            "description":"the function in the script path(don`t use xxx.__yyy__() in python code.)"
                        },
                        "args":{
                            "type":"object",
                            "description":"argument list"
                        },
                        "filetype":{
                            "type":"string",
                            "enum":["python","javascript","shell"],
                            "description":"the script file`s type"
                        }
                    },
                    "required":["script","function","filetype"]
                }
            }
        },
        "knowledge_search":{
            "type":"function",
            "function":{
                "name":"knowledge_search",
                "description":"在本地知识库中做语义检索,返回与问题最相关的文本片段,用于回答用户问题时补充背景知识",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "query":{
                            "type":"string",
                            "description":"要检索的问题或关键词"
                        },
                        "top_k":{
                            "type":"integer",
                            "description":"返回片段数,默认 5"
                        }
                    },
                    "required":["query"]
                }
            }
        },
        "remember":{
            "type":"function",
            "function":{
                "name":"remember",
                "description":"记住一条关于用户的重要信息(如个人信息、偏好、任务背景、待办等),保存后可随时回忆。当用户主动告知个人信息、表达偏好或要求你记住某件事时调用",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "fact":{
                            "type":"string",
                            "description":"要记住的事实或信息,尽量完整具体"
                        }
                    },
                    "required":["fact"]
                }
            }
        },
        "recall_memory":{
            "type":"function",
            "function":{
                "name":"recall_memory",
                "description":"回忆与问题相关的长期记忆(用户之前让你记住的信息)。会检索 2-10 条相关记忆并汇总成一条完整记忆返回,用于回答需要过往信息的问题",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "query":{
                            "type":"string",
                            "description":"要回忆的内容关键词或问题"
                        },
                        "top_k":{
                            "type":"integer",
                            "description":"检索并参与汇总的记忆条数,范围 2-10,默认 5"
                        }
                    },
                    "required":["query"]
                }
            }
        },
        "run_command":{
            "type":"function",
            "function":{
                "name":"run_command",
                "description":"在安全沙箱环境中执行 shell 命令并返回输出。执行前会向用户请求审批。用于运行构建、测试、安装依赖、查看文件、生成文档等实际操作",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "command":{
                            "type":"string",
                            "description":"要执行的完整 shell 命令"
                        },
                        "reason":{
                            "type":"string",
                            "description":"为什么需要执行这条命令,让用户理解并审批"
                        },
                        "cwd":{
                            "type":"string",
                            "description":"工作目录(绝对路径,默认项目根目录)"
                        }
                    },
                    "required":["command","reason"]
                }
            }
        },
        "web_search":{
            "type":"function",
            "function":{
                "name":"web_search",
                "description":"联网搜索实时信息(基于 bing 技能),返回网页标题、摘要与链接。用于天气、新闻、事实查询等需要实时数据的问题",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "query":{
                            "type":"string",
                            "description":"搜索关键词或完整问题"
                        },
                        "top_n":{
                            "type":"integer",
                            "description":"返回结果条数,默认 5"
                        }
                    },
                    "required":["query"]
                }
            }
        },
        "fetch_url":{
            "type":"function",
            "function":{
                "name":"fetch_url",
                "description":"打开并读取网页内容(标题+正文,自动截断)。用于查看搜索结果链接的具体内容,天气可直接打开 wttr.in/<城市>,也可读新闻/百科页面",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "url":{
                            "type":"string",
                            "description":"要访问的完整 URL"
                        },
                        "max_chars":{
                            "type":"integer",
                            "description":"正文最大字符数,默认 6000"
                        }
                    },
                    "required":["url"]
                }
            }
        },
        "read_file":{
            "type":"function",
            "function":{
                "name":"read_file",
                "description":"读取文本文件内容(UTF-8,自动截断)。用于查看源码、配置、文档等",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "path":{
                            "type":"string",
                            "description":"文件路径(绝对路径,或相对项目根目录)"
                        }
                    },
                    "required":["path"]
                }
            }
        },
        "write_file":{
            "type":"function",
            "function":{
                "name":"write_file",
                "description":"写入或覆盖文本文件(自动创建目录),写入前会请你审批",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "path":{
                            "type":"string",
                            "description":"文件路径(绝对路径,或相对项目根目录)"
                        },
                        "content":{
                            "type":"string",
                            "description":"要写入的完整内容"
                        }
                    },
                    "required":["path","content"]
                }
            }
        },
        "create_plan":{
            "type":"function",
            "function":{
                "name":"create_plan",
                "description":"为复杂多步任务创建执行计划,拆解为步骤列表。返回 plan_id,后续用 update_step 标记进度",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "title":{
                            "type":"string",
                            "description":"任务标题"
                        },
                        "steps":{
                            "type":"array",
                            "items":{"type":"string"},
                            "description":"按执行顺序排列的步骤描述"
                        }
                    },
                    "required":["title","steps"]
                }
            }
        },
        "update_step":{
            "type":"function",
            "function":{
                "name":"update_step",
                "description":"更新计划中某一步的状态:pending/in_progress/done/blocked。执行中逐步标记进度",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "plan_id":{
                            "type":"integer",
                            "description":"create_plan 返回的计划编号"
                        },
                        "seq":{
                            "type":"integer",
                            "description":"步骤序号(从 0 开始)"
                        },
                        "status":{
                            "type":"string",
                            "enum":["pending","in_progress","done","blocked"],
                            "description":"步骤新状态"
                        }
                    },
                    "required":["plan_id","seq","status"]
                }
            }
        },
        "get_plan":{
            "type":"function",
            "function":{
                "name":"get_plan",
                "description":"查看计划详情与各步骤状态,用于恢复或检查进度",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "plan_id":{
                            "type":"integer",
                            "description":"计划编号"
                        }
                    },
                    "required":["plan_id"]
                }
            }
        },
        "complete_plan":{
            "type":"function",
            "function":{
                "name":"complete_plan",
                "description":"标记整个计划完成(未完成步骤一并置为 done)",
                "parameters":{
                    "type":"object",
                    "properties":{
                        "plan_id":{
                            "type":"integer",
                            "description":"计划编号"
                        }
                    },
                    "required":["plan_id"]
                }
            }
        }
    }
}
